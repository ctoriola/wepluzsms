# =============================================================================
# Browser settings (public by design - they ship in the web page).
# Firebase console > Project settings > General > Your apps > Web app > Config
# =============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Demo mode: one-click sign-in buttons for the demo accounts and a "demo"
# banner. Use only with the demo install. NEVER true for real schools.
VITE_DEMO_MODE=false

# Optional: if schools use subdomains (greenfield.app.example.com), the root
# domain lets the login page show the right school's logo and colours.
VITE_APP_ROOT_DOMAIN=

# Local development only: use the Firebase emulators (npm run emulators).
VITE_USE_EMULATORS=false

# =============================================================================
# Server secrets (Vercel > Settings > Environment Variables). NEVER commit real
# values. Not prefixed with VITE_, so they never reach the browser.
# =============================================================================
# Firebase console > Project settings > Service accounts > Generate new private key.
# Paste the whole JSON file contents (or its base64).
FIREBASE_SERVICE_ACCOUNT=

# Any long random string. Needed once to run /setup; also protects SMS login codes.
SETUP_TOKEN=

# Optional until you connect Termii: parent SMS login codes.
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=
