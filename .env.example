# Copy to .env.local and fill in from Supabase > Project Settings > API.
# Both values are designed to be public (they ship in the browser). Security
# comes from row-level security in the database, NOT from hiding these.
# Never put the service_role key, Paystack secret key or Termii key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: if schools use subdomains (greenfield.app.example.com), set the root
# domain so the login page can show the right school's logo and colours.
VITE_APP_ROOT_DOMAIN=

# Demo mode: shows one-click sign-in buttons for the seeded demo accounts and a
# "demo" banner. Use only with the demo seed data. NEVER set true in production.
VITE_DEMO_MODE=false
