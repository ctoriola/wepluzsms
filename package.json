{
  "name": "wepluzsms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:server": "npx firebase-tools@13.29.1 emulators:exec --only auth,firestore --project demo-wepluz \"vitest run --config vitest.server.config.ts\"",
    "emulators": "npx firebase-tools@13.29.1 emulators:start --only auth,firestore --project demo-wepluz",
    "vercel-build": "node scripts/sync-rules.mjs && npm run build"
  },
  "dependencies": {
    "firebase": "11.1.0",
    "firebase-admin": "13.0.2",
    "lucide-react": "0.447.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "@types/node": "22.10.2",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.2",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2",
    "vite": "5.4.8",
    "vitest": "2.1.2"
  }
}
