rules_version = '2';

// =============================================================================
// Wepluz Firestore security rules
//
// Model: the browser only READS. Every change goes through the server API
// (api/rpc.ts), which checks permissions and school rules before writing with
// the Admin SDK. So every client write below is denied.
//
// Each school's data lives under /schools/{schoolId}. A person can read a
// school's data only if they have an active membership there (or are a
// MANDEXA platform admin), and the school itself is active.
//
// These rules are deployed automatically by the /setup page and on every
// Vercel build (scripts/sync-rules.mjs).
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function platformAdmin() {
      return signedIn() && request.auth.token.platformAdmin == true;
    }
    function memberPath(sid) {
      return /databases/$(database)/documents/schools/$(sid)/members/$(request.auth.uid);
    }
    function isMember(sid) {
      return platformAdmin() || (
        signedIn()
        && exists(memberPath(sid))
        && get(memberPath(sid)).data.status == 'active'
        && get(/databases/$(database)/documents/schools/$(sid)).data.status == 'active'
      );
    }
    function hasRole(sid, roles) {
      return platformAdmin() || (isMember(sid) && get(memberPath(sid)).data.roles.hasAny(roles));
    }
    function isStaff(sid) {
      return hasRole(sid, ['proprietor', 'principal', 'school_admin', 'bursar', 'teacher']);
    }
    function isAdmin(sid) {
      return hasRole(sid, ['proprietor', 'principal', 'school_admin']);
    }

    // Your own profile and list of schools.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /schools/{sid} {
      allow read: if isMember(sid);
      allow write: if false;

      // Memberships: you can see your own; admins see everyone in the school.
      match /members/{uid} {
        allow read: if (signedIn() && request.auth.uid == uid) || isAdmin(sid);
        allow write: if false;
      }

      // Logo and other branding assets.
      match /assets/{assetId} {
        allow read: if isMember(sid);
        allow write: if false;
      }

      // Audit trail: proprietor and principal only.
      match /auditLog/{entryId} {
        allow read: if hasRole(sid, ['proprietor', 'principal']);
        allow write: if false;
      }

      // Academic calendar and structure: everyone in the school can read.
      match /sessions/{id} {
        allow read: if isMember(sid);
        allow write: if false;
      }
      match /terms/{id} {
        allow read: if isMember(sid);
        allow write: if false;
      }
      match /classLevels/{id} {
        allow read: if isMember(sid);
        allow write: if false;
      }
      match /classArms/{id} {
        allow read: if isMember(sid);
        allow write: if false;
      }
      match /subjects/{id} {
        allow read: if isMember(sid);
        allow write: if false;
      }

      // Teacher assignments: staff only.
      match /assignments/{id} {
        allow read: if isStaff(sid);
        allow write: if false;
      }
    }

    // Everything else (login codes, slugs, platform config) is server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
